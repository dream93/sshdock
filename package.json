{
  "name": "sshdock",
  "version": "1.0.1",
  "description": "A visual cross-platform SSH shell client with password and key authentication.",
  "main": "src/main.cjs",
  "author": "SSHDock",
  "license": "MIT",
  "private": true,
  "scripts": {
    "test": "node --test test/*.test.cjs",
    "postinstall": "node scripts/fix-pty-perms.cjs",
    "start": "electron .",
    "dist": "electron-builder",
    "dist:mac": "electron-builder --mac pkg",
    "dist:win": "electron-builder --win nsis portable --x64",
    "dist:win:arm64": "electron-builder --win nsis portable --arm64"
  },
  "dependencies": {
    "@xterm/addon-canvas": "^0.7.0",
    "@xterm/addon-fit": "^0.10.0",
    "@xterm/xterm": "^5.5.0",
    "node-pty": "^1.1.0",
    "ssh2": "^1.16.0"
  },
  "devDependencies": {
    "@electron/rebuild": "^4.0.4",
    "electron": "^30.5.1",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "appId": "com.sshdock.app",
    "productName": "SSHDock",
    "directories": {
      "buildResources": "build"
    },
    "afterPack": "scripts/after-pack.cjs",
    "compression": "maximum",
    "files": [
      "src/**/*",
      "node_modules/**/*",
      "package.json",
      "!**/*.map",
      "!**/*.ts",
      "!**/*.md",
      "!**/{test,tests,__tests__,example,examples,doc,docs,demo}/**",
      "!**/*.{o,obj,a,pdb}",
      "!node_modules/@xterm/*/src/**",
      "!node_modules/@xterm/*/typings/**",
      "!node_modules/node-pty/{deps,third_party,src,scripts}/**",
      "!node_modules/node-pty/**/*.test.js",
      "!node_modules/cpu-features/deps/**",
      "!node_modules/cpu-features/build/Release/{obj.target,.deps}/**",
      "!node_modules/cpu-features/build/deps/**",
      "!node_modules/buildcheck/deps/**"
    ],
    "asar": true,
    "asarUnpack": [
      "node_modules/node-pty/**"
    ],
    "mac": {
      "icon": "build/icon.icns",
      "target": [
        "pkg"
      ],
      "category": "public.app-category.developer-tools"
    },
    "pkg": {
      "installLocation": "/Applications"
    },
    "win": {
      "icon": "build/icon.ico",
      "target": [
        "nsis",
        "portable"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  }
}
